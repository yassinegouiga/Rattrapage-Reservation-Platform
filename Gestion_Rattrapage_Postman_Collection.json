                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/salles",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "salles"]
            }
          }
        }
