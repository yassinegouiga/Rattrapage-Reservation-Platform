              "raw": "{\n  \"date\": \"2026-05-24\",\n  \"heureDebut\": \"10:00:00\",\n  \"heureFin\": \"12:00:00\",\n  \"enseignant\": {\n    \"id\": {{user_id}}\n  },\n  \"salle\": {\n    \"id\": 1\n  },\n  \"seance\": {\n    \"matiere\": \"Java EE\",\n    \"groupe\": \"Classe 3A\"\n  }\n}"
            },
