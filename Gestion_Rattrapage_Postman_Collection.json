        {
          "name": "Create Salle",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Salle A101\",\n  \"capacite\": 40,\n  \"localisation\": \"Bloc A, 1er étage\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/salles",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "salles"]
            }
          }
        },
        {
          "name": "Get All Salles",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
